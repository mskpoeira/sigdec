NODE_ENV=development
SIGDEC_APP_NAME=SIGDEC
SIGDEC_PUBLIC_URL=http://localhost:3000
SIGDEC_API_URL=http://localhost:4000
NEXT_PUBLIC_SIGDEC_API_URL=http://localhost:4000

POSTGRES_DB=sigdec
POSTGRES_USER=sigdec
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://sigdec:replace-with-random-local-password@localhost:5432/sigdec
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=replace-with-random-local-user
MINIO_ROOT_PASSWORD=replace-with-random-local-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sigdec
S3_ACCESS_KEY=replace-with-random-local-user
S3_SECRET_KEY=replace-with-random-local-password
# Bucket dedicado a ZIPs SIDEC com S3 Object Lock habilitado desde a criação.
SIDEC_WORM_BUCKET=sigdec-worm-v1
# GOVERNANCE permite administração autorizada; COMPLIANCE é mais restritivo e deve ser adotado apenas com política formal.
SIDEC_WORM_MODE=GOVERNANCE
# Verificação remota periódica dos objetos arquivados (mínimo 60 min).
SIDEC_WORM_VERIFICATION_MINUTES=1440
# Resiliência operacional: evaluator frequente, retry exponencial e drills de restauração.
SIDEC_RESILIENCE_EVALUATION_MINUTES=15
SIDEC_REPLICA_RETRY_BASE_MINUTES=15
SIDEC_REPLICA_RETRY_MAX_MINUTES=1440
SIDEC_RESILIENCE_ALERT_AFTER_HOURS=6
SIDEC_RESTORE_DRILL_HOURS=168
# Ações corretivas de AAR: janela de aviso e frequência do avaliador.
SIDEC_CONTINUITY_ACTION_DUE_SOON_HOURS=72
SIDEC_CONTINUITY_ACTION_ALERT_MINUTES=60
# Após este período sem verificação válida, o arquivo aparece como STALE no Centro de Gestão.
SIDEC_WORM_STALE_HOURS=48
# Segunda cópia WORM. Em produção, aponte preferencialmente para outro endpoint/provedor/região.
SIDEC_WORM_REPLICA_ENABLED=false
SIDEC_WORM_REPLICA_ENDPOINT=
SIDEC_WORM_REPLICA_REGION=
SIDEC_WORM_REPLICA_BUCKET=sigdec-worm-replica-v1
SIDEC_WORM_REPLICA_ACCESS_KEY=
SIDEC_WORM_REPLICA_SECRET_KEY=
SIDEC_WORM_REPLICA_MODE=GOVERNANCE

# Gere um segredo aleatório forte (mínimo recomendado: 32 bytes).
JWT_SECRET=change-me-with-at-least-32-random-characters
# Chave dedicada e estável para assinatura interna HMAC dos manifestos SIDEC.
# Se omitida, o SIGDEC usa JWT_SECRET por compatibilidade; em produção, prefira chave própria.
SIDEC_MANIFEST_SIGNING_SECRET=change-me-with-another-32-random-characters
# ID lógico da chave ativa. "legacy-v1" preserva compatibilidade com assinaturas da v1.16.
SIDEC_MANIFEST_SIGNING_KEY_ID=legacy-v1
# Para rotação, mantenha segredos históricos disponíveis por ID. Exemplo:
# SIDEC_MANIFEST_SIGNING_KEYS_JSON={"2026-q4":"another-strong-secret-with-32-plus-chars","2027-q1":"next-strong-secret-with-32-plus-chars"}
SIDEC_MANIFEST_SIGNING_KEYS_JSON=
# Avaliação automática de SLAs operacionais SIDEC (mínimo 5 minutos).
SIDEC_DEADLINE_EVALUATION_MINUTES=60
# Assinatura pública Ed25519 do comprovante de integridade.
# Seed privada dedicada: exatamente 32 bytes codificados em base64.
# Se omitida, o SIGDEC deriva uma seed do segredo interno apenas para compatibilidade/homologação.
SIDEC_ED25519_PRIVATE_SEED_BASE64=
SIDEC_ED25519_KEY_ID=derived-v1
# Assinatura Ed25519 dedicada aos checkpoints da auditoria.
# Pode ser rotacionada alterando o keyId e a seed; comprovantes antigos preservam a chave pública.
AUDIT_ED25519_PRIVATE_SEED_BASE64=
AUDIT_ED25519_KEY_ID=audit-derived-v1
SESSION_HOURS=8
# Opcional: chave dedicada para cifrar segredos TOTP/webhook. Se omitida, usa JWT_SECRET como material de chave.
MFA_ENCRYPTION_KEY=
# Perfis com nível de papel igual ou superior exigem MFA automaticamente.
MFA_STRATEGIC_ROLE_LEVEL=80
# Após validar TOTP, lembrar este navegador/dispositivo por este período.
MFA_TRUSTED_DEVICE_DAYS=30
# Worker de entrega de webhooks (10–300 s).
WEBHOOK_DISPATCH_SECONDS=30

# Organização inicial
SIGDEC_ORG_NAME=
SIGDEC_ORG_SLUG=

# PRIMEIRO MASTER: preencher somente no ambiente seguro de implantação.
# A matrícula será normalizada automaticamente (ex.: 915.789 -> 915789).
SIGDEC_MASTER_MATRICULA=
SIGDEC_MASTER_NAME=
SIGDEC_MASTER_EMAIL=
SIGDEC_MASTER_PHONE=
SIGDEC_MASTER_JOB_TITLE=
SIGDEC_MASTER_DEPARTMENT=
SIGDEC_MASTER_PASSWORD=

# Recuperação de senha por e-mail
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SIGDEC_MAIL_FROM=

# E-mail institucional da Prefeitura — SMTP + IMAP
INSTITUTIONAL_WEBMAIL_URL=https://webmail.ubatuba.sp.gov.br/
INSTITUTIONAL_MAILBOX_LABEL=Webmail da Prefeitura de Ubatuba
INSTITUTIONAL_SMTP_HOST=mail.ubatuba.sp.gov.br
INSTITUTIONAL_SMTP_PORT=465
INSTITUTIONAL_SMTP_SECURE=true
INSTITUTIONAL_IMAP_HOST=mail.ubatuba.sp.gov.br
INSTITUTIONAL_IMAP_PORT=993
INSTITUTIONAL_IMAP_SECURE=true
INSTITUTIONAL_MAIL_USER=
INSTITUTIONAL_MAIL_PASSWORD=
INSTITUTIONAL_MAIL_FROM=


# Inteligência artificial assistiva para relatórios técnicos
# Sem chave, o SIGDEC mantém geração determinística de minuta para revisão humana.
SIGDEC_AI_ENABLED=true
# Ordem de tentativa do assistente contextual. Somente provedores com chave no servidor são usados.
SIGDEC_AI_PROVIDER_ORDER=OPENAI,GEMINI,GROQ,OLLAMA
SIGDEC_AI_CONTEXT_PROVIDER_ORDER=GROQ,GEMINI,OPENAI,OLLAMA
SIGDEC_AI_REPORT_PROVIDER_ORDER=OPENAI,GEMINI,OLLAMA,GROQ
SIGDEC_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# Google Gemini API (chave criada pelo administrador no Google AI Studio; nunca expor no cliente).
SIGDEC_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# GroqCloud opcional para análise rápida com modelo aberto.
SIGDEC_GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Ollama local opcional — sem chave; URL somente de infraestrutura confiável.
SIGDEC_OLLAMA_URL=
SIGDEC_OLLAMA_MODEL=gpt-oss:20b

# GeoPixel: sincronização periódica e exportação bidirecional.
# Habilite rede privada somente se o endpoint oficial GeoPixel for interno à rede municipal.
GEOPIXEL_ALLOW_PRIVATE_NETWORK=false
GEOPIXEL_SYNC_EVALUATION_MINUTES=10
GEOPIXEL_EXPORT_DISPATCH_SECONDS=30

# SEI Cidades: habilite rede privada somente quando o Web Service oficial estiver em rede interna autorizada.
SEI_ALLOW_PRIVATE_NETWORK=false
