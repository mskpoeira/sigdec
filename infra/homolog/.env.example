# Domínio do ambiente
SIGDEC_DOMAIN=sigdec.mskpoeira.com.br

# Banco interno
POSTGRES_DB=sigdec
POSTGRES_USER=sigdec
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_LONG_PASSWORD

# Sessões
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
# Manter estável entre deploys para validar artefatos SIDEC já selados.
SIDEC_MANIFEST_SIGNING_SECRET=CHANGE_ME_RANDOM_64_CHARS_DIFFERENT_FROM_JWT
# Preserve o ID e a chave enquanto houver artefatos assinados por ela.
SIDEC_MANIFEST_SIGNING_KEY_ID=legacy-v1
# Ao rotacionar, informe as chaves antiga e nova no JSON até encerrar a retenção dos artefatos históricos.
SIDEC_MANIFEST_SIGNING_KEYS_JSON=
SIDEC_DEADLINE_EVALUATION_MINUTES=60
# Em produção, usar seed Ed25519 dedicada e preservar o keyId usado em cada atestação.
SIDEC_ED25519_PRIVATE_SEED_BASE64=
SIDEC_ED25519_KEY_ID=derived-v1
SESSION_HOURS=8

# Armazenamento de anexos
MINIO_ROOT_USER=sigdec-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_LONG_PASSWORD
S3_REGION=us-east-1
S3_BUCKET=sigdec
# Bucket separado criado automaticamente com --with-lock pelo minio-init.
SIDEC_WORM_BUCKET=sigdec-worm-v1
SIDEC_WORM_MODE=GOVERNANCE
SIDEC_WORM_VERIFICATION_MINUTES=1440

# Organização
SIGDEC_ORG_NAME=Prefeitura Municipal de Ubatuba
SIGDEC_ORG_SLUG=ubatuba

# Primeiro administrador Master
# A matrícula aceita máscara; será normalizada para 915789.
SIGDEC_MASTER_MATRICULA=915.789
SIGDEC_MASTER_NAME=Thiago Alves Cardozo
SIGDEC_MASTER_EMAIL=
SIGDEC_MASTER_PHONE=
SIGDEC_MASTER_JOB_TITLE=Administrador Master
SIGDEC_MASTER_DEPARTMENT=SIGDEC
SIGDEC_MASTER_PASSWORD=CHANGE_ME_ONE_TIME_PASSWORD

# Recuperação de senha por e-mail
PASSWORD_RESET_MINUTES=30
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME_MAILBOX
SMTP_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
SIGDEC_MAIL_FROM=SIGDEC <CHANGE_ME_MAILBOX>
